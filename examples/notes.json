{
  "name": "Notes API",
  "version": "0.1.0",
  "entities": [
    {
      "name": "Note",
      "primaryKey": "slug",
      "fields": [
        { "name": "slug", "type": "string", "required": true, "unique": true, "nullable": false, "minLength": 1, "maxLength": 80 },
        { "name": "title", "type": "string", "required": true, "unique": false, "nullable": false, "minLength": 1, "maxLength": 120 },
        { "name": "content", "type": "string", "required": false, "unique": false, "nullable": true },
        { "name": "pinned", "type": "boolean", "required": false, "unique": false, "nullable": false, "defaultValue": false },
        { "name": "revision", "type": "integer", "required": false, "unique": false, "nullable": false, "defaultValue": 0 },
        { "name": "dueDate", "type": "date", "required": false, "unique": false, "nullable": true },
        { "name": "publishedAt", "type": "datetime", "required": false, "unique": false, "nullable": true },
        { "name": "createdAt", "type": "datetime", "required": true, "unique": false, "nullable": false, "autoGenerated": "createdAt" },
        { "name": "updatedAt", "type": "datetime", "required": true, "unique": false, "nullable": false, "autoGenerated": "updatedAt" }
      ]
    }
  ],
  "relationships": [],
  "apis": [
    { "name": "List Notes", "method": "GET", "path": "/notes", "entity": "Note", "operation": "list" },
    { "name": "Create Note", "method": "POST", "path": "/notes", "entity": "Note", "operation": "create" },
    { "name": "Get Note", "method": "GET", "path": "/notes/:slug", "entity": "Note", "operation": "get" },
    { "name": "Update Note", "method": "PUT", "path": "/notes/:slug", "entity": "Note", "operation": "update" },
    { "name": "Delete Note", "method": "DELETE", "path": "/notes/:slug", "entity": "Note", "operation": "delete" }
  ]
}
