{
  "name": "Ecommerce API",
  "version": "0.1.0",
  "entities": [
    {
      "name": "User",
      "primaryKey": "id",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "unique": true,
          "nullable": false
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "unique": false,
          "nullable": false,
          "minLength": 2,
          "maxLength": 100
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "unique": true,
          "nullable": false,
          "minLength": 5,
          "maxLength": 255
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "unique": false,
          "nullable": false,
          "autoGenerated": "createdAt"
        }
      ]
    },
    {
      "name": "Product",
      "primaryKey": "id",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "unique": true,
          "nullable": false
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "unique": false,
          "nullable": false,
          "minLength": 2,
          "maxLength": 200
        },
        {
          "name": "price",
          "type": "number",
          "required": true,
          "unique": false,
          "nullable": false
        }
      ]
    }
  ],
  "relationships": [],
  "apis": [
    {
      "name": "List Users",
      "method": "GET",
      "path": "/users",
      "entity": "User",
      "operation": "list"
    },
    {
      "name": "Create User",
      "method": "POST",
      "path": "/users",
      "entity": "User",
      "operation": "create"
    },
    {
      "name": "Get User",
      "method": "GET",
      "path": "/users/:id",
      "entity": "User",
      "operation": "get"
    },
    {
      "name": "Update User",
      "method": "PUT",
      "path": "/users/:id",
      "entity": "User",
      "operation": "update"
    },
    {
      "name": "Delete User",
      "method": "DELETE",
      "path": "/users/:id",
      "entity": "User",
      "operation": "delete"
    },
    {
      "name": "List Products",
      "method": "GET",
      "path": "/products",
      "entity": "Product",
      "operation": "list"
    },
    {
      "name": "Create Product",
      "method": "POST",
      "path": "/products",
      "entity": "Product",
      "operation": "create"
    }
  ]
}
